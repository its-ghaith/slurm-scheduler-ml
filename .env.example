# Copy to .env and fill with real values. Do not commit .env.

# Required for pulling GHCR images from Kubernetes
CR_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GHCR_USER=<your-github-username>
GHCR_SERVER=<ghcr.io>
GHCR_IMAGE=ghcr.io/<your-github-username>/slurm-scheduler-ml/mlops-slurm-runtime:latest

# Optional setup_rancher.ps1 defaults
ACTION=bootstrap
KUBECONFIG_PATH=rancherConfigs/main.yaml
K8S_NAMESPACE=<your-k8s-namespace>
K8S_MANIFEST=rancherConfigs/hybrid-stack.yaml

# Required for Hybrid-Connector -> external Slurm
SLURM_SSH_HOST=<slurm-login.example.org>
SLURM_SSH_PORT=22
SLURM_SSH_USER=<slurm-user>

# Private SSH key content (single-line with \n or plain multiline in your local .env)
SLURM_SSH_PRIVATE_KEY=<paste-private-key-here>
# known_hosts entry for strict host key checking
SLURM_SSH_KNOWN_HOSTS=<slurm-login.example.org ssh-ed25519 AAAA...>

# Remote project path on external Slurm cluster where your repo/scripts exist
REMOTE_PROJECT_DIR=/home/<slurm-user>/mlops-project
REMOTE_SLURM_SCRIPT=slurm/train_distributed_mlflow_job.slurm
# URL reachable from external Slurm node back to Kubernetes MLflow
REMOTE_MLFLOW_TRACKING_URI=http://<reachable-mlflow-host>:5000

# Optional reverse SSH tunnel (0/1)
ENABLE_REVERSE_TUNNEL=0
REVERSE_TUNNEL_BIND=5000:mlflow.mlops-energy.svc.cluster.local:5000
SSH_STRICT_HOST_KEY_CHECKING=yes

# Optional SLURM submit overrides
BATCH_SIZE=64
MLFLOW_TRACKING_URI=http://mlflow:5000
GPU_SAMPLE_INTERVAL_SEC=1
ELECTRICITY_PRICE_EUR_PER_KWH=0.30
GRID_CO2_KG_PER_KWH=0.40
PUE_FACTOR=1.0
MLFLOW_LOG_JOB_ENERGY=1
MLFLOW_JOB_ENERGY_EXPERIMENT=ml-energy-poc
