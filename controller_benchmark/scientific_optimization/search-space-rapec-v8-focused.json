    "min_epochs_floor": {
      "type": "int",
      "low": 12,
      "high": 97,
      "safe": "high",
      "aggressive": "low"
    },
    "utility_quantile": {
      "type": "float",
      "low": 0.01,
      "high": 0.75,
      "safe": "low",
      "aggressive": "high"
    },
    "noise_multiplier": {
      "type": "float",
      "low": 0.25,
      "high": 4.0,
      "safe": "low",
      "aggressive": "high"
    },
    "minimum_quality_floor": {
      "type": "float",
      "low": 0.0,
      "high": 0.7,
      "safe": "high",
      "aggressive": "low"
    }
  }
}
