{
  "schema_version": 1,
  "method": "Morris-screened constrained qLogNEHVI",
  "mandatory_parameters": [
    "min_epochs_floor",
    "patience",
    "max_probability_gain_gt_threshold"
  ],
  "parameters": {
    "horizon_epochs": {"type": "int", "low": 3, "high": 15},
    "min_fit_points": {"type": "int", "low": 6, "high": 20},
    "patience": {"type": "int", "low": 2, "high": 8},
    "trend_window": {"type": "int", "low": 6, "high": 25},
    "bootstrap_samples": {"type": "categorical", "choices": [32, 64, 96, 128, 192]},
    "knn_neighbors": {"type": "int", "low": 3, "high": 15},
    "min_epochs_floor": {"type": "int", "low": 8, "high": 97},
    "max_probability_gain_gt_threshold": {"type": "float", "low": 0.05, "high": 0.45},
    "max_uncertainty_to_gain_ratio": {"type": "float", "low": 1.5, "high": 8.0},
    "minimum_quality_floor": {"type": "fixed", "value": 0.0},
    "noise_multiplier": {"type": "float", "low": 0.5, "high": 3.0},
    "recent_gain_fraction": {"type": "float", "low": 0.1, "high": 0.8},
    "remaining_room_fraction": {"type": "float", "low": 0.001, "high": 0.08, "log": true},
    "late_stage_relaxation": {"type": "float", "low": 0.0, "high": 0.9},
    "min_meaningful_gain": {"type": "float", "low": 0.000001, "high": 0.001, "log": true},
    "utility_quantile": {"type": "float", "low": 0.05, "high": 0.5},
    "warmup_signal_to_noise_ratio": {"type": "float", "low": 0.5, "high": 6.0},
    "warmup_noise_stability_ratio": {"type": "float", "low": 1.1, "high": 5.0},
    "warmup_required_stable_windows": {"type": "int", "low": 1, "high": 5}
  }
}
