# PROD profile (External real Slurm)
ACTION=bootstrap
KUBECONFIG_PATH=rancherConfigs/main.yaml
K8S_NAMESPACE=mlops-energy
K8S_MANIFEST=rancherConfigs/hybrid-stack.yaml

CR_PAT=
GHCR_USER=its-ghaith
GHCR_SERVER=ghcr.io
GHCR_IMAGE=ghcr.io/its-ghaith/slurm-scheduler-ml/mlops-slurm-runtime:latest

SLURM_SSH_HOST=
SLURM_SSH_PORT=22
SLURM_SSH_USER=
# Use exactly one of these two:
SLURM_SSH_PRIVATE_KEY=
SLURM_SSH_PRIVATE_KEY_FILE=
SLURM_SSH_KNOWN_HOSTS=

REMOTE_PROJECT_DIR=/home/slurm/mlops-project
REMOTE_SLURM_SCRIPT=slurm/train_distributed_mlflow_job.slurm
REMOTE_MLFLOW_TRACKING_URI=http://mlflow.mlops-energy.svc.cluster.local:5000
ENABLE_REVERSE_TUNNEL=0
REVERSE_TUNNEL_BIND=5000:mlflow.mlops-energy.svc.cluster.local:5000
SSH_STRICT_HOST_KEY_CHECKING=yes

BATCH_SIZE=64
GPU_SAMPLE_INTERVAL_SEC=1
ELECTRICITY_PRICE_EUR_PER_KWH=0.30
GRID_CO2_KG_PER_KWH=0.40
PUE_FACTOR=1.0
MLFLOW_LOG_JOB_ENERGY=1
MLFLOW_JOB_ENERGY_EXPERIMENT=ml-energy-poc
