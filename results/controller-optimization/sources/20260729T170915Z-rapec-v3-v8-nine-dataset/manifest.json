{
  "benchmark_version": "controller-benchmark-v3-nine-dataset-fresh",
  "description": "Fresh cross-dataset and cross-task comparison of unchanged RAPEC-v3 and RAPEC-v8 controllers.",
  "execution": {
    "namespace": "mlops-energy",
    "kubeconfig": "rancherConfigs/main.yaml",
    "experiment_name": "controller-benchmark-v3-nine-dataset-fresh",
    "max_epochs": 100,
    "batch_size": 8,
    "image_size": 640,
    "split_seed": 0,
    "cache_policy": "persistent-disk",
